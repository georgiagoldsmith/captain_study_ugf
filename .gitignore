# RStudio / R
.Rproj.user
.Rhistory
.RData
.Ruserdata
.positai

# macOS
.DS_Store

# ---- Data ----------------------------------------------------------------
# Most of data/ is large rasters (gHM alone is 2.1 GB, and is a symlink here),
# so the folder is ignored by default. The exceptions below are small files
# that are slow or impossible to rebuild: the study boundary, the species
# trait tables, the protected-area clip, and the grid template.
data/*
!data/UGF_gp.shp/
!data/birds_species_traits/
!data/captain/
!data/protected areas/
!data/birds_aoh/
!data/gHM/

# gHM.tif itself is a 2.1 GB symlink; only the derived future layer is tracked
data/gHM/*
!data/gHM/disturbance_future_2075.tif

data/protected areas/*
!data/protected areas/protected_areas_ugf.*

data/birds_aoh/*
!data/birds_aoh/*.csv

# ---- Outputs -------------------------------------------------------------
# Everything here is regenerated by the scripts; see README.
outputs/
